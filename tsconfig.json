{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": false,                // 엄격한 타입 검사 비활성화
    "noImplicitAny": false,         // 암시적인 any 타입을 허용
    "noUnusedLocals": false,        // 사용하지 않는 변수 경고 비활성화
    "noUnusedParameters": false,    // 사용하지 않는 매개변수 경고 비활성화
    "suppressImplicitAnyIndexErrors": true,  // any 타입을 인덱스에서 사용할 때 경고 비활성화
    "skipLibCheck": true,           // 라이브러리 파일 타입 검사를 건너뛰기 (주로 속도 향상)
    "noImplicitReturns": false,     // 함수에서 반환 값이 없을 경우 경고 비활성화
"noFallthroughCasesInSwitch": false // switch문에서 case가 빠지는 경고 비활성화     ₩                                   ~~~~~~~~~~~~~~~~~
  
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
